# Preview build: the panel installs into Premiere and runs on sample data, with no backend.
# Set to 0 (or delete this file) once the backend ships, then tag the next release.
VITE_GENIUSCUT_PREVIEW=1

# The Claude assistant bridge: personal builds only. Never 1 here; a personal build sets it in the
# gitignored .env.production.local (with VITE_GENIUSCUT_PREVIEW=0).
VITE_GENIUSCUT_CLAUDE=0
